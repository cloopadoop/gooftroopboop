{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Goof Troop Boop",
  "version": "0.1.1",
  "identifier": "com.gooftroopboop.studio",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Goof Troop Boop",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "media-src": "'self' asset: http://asset.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": ["$TEMP/gtb-render-*.wav"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "bin/gtb-engine.exe": "bin/gtb-engine.exe",
      "bin/Qt6Core.dll": "bin/Qt6Core.dll",
      "bin/GTBoop-cli.exe": "bin/GTBoop-cli.exe",
      "bin/soundbank.spc": "bin/soundbank.spc",
      "bin/msvcp140.dll": "bin/msvcp140.dll",
      "bin/msvcp140_1.dll": "bin/msvcp140_1.dll",
      "bin/vcruntime140.dll": "bin/vcruntime140.dll",
      "bin/vcruntime140_1.dll": "bin/vcruntime140_1.dll"
    }
  },
  "plugins": {}
}
