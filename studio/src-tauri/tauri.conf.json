{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Goof Troop Boop",
  "version": "0.1.0",
  "identifier": "com.gooftroopboop.studio",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Goof Troop Boop",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "bin/": "bin/" }
  },
  "plugins": {}
}
